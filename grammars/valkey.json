            "match": "(?i:\\b(l2|nostem|vector|float32|stopwords|distance_metric|stddev|score|ef_runtime|sum|someshards|min|apply|timeout|sortby|load|hash|reduce|max|prefix|punctuation|type|withsortkeys|dim|text|withsuffixtrie|hnsw|nocontent|return|filter|m|allshards|consistent|ef_construction|inconsistent|withoffsets|on|skipinitialscan|verbatim|as|inorder|nosuffixtrie|nooffsets|count_distinct|count|params|minstemsize|asc|limit|avg|flat|language|tag|sortable|ip|initial_cap|cosine|desc|slop|numeric|\\*|nostopwords|cluster|dialect|local|groupby|primary|weight|json|casesensitive|separator|schema)\\b)"
