{
    "displayName": "valkey",
    "name": "valkey",
    "patterns": [
        {
            "match": "\"(.+?)\"",
            "name": "string.quoted.double"
        },
        {
            "match": "'(.+?)'",
            "name": "string.quoted.single"
        },
        {
            "match": "^([^\\s]*?>)",
            "name": "comment"
        },
        {
            "match": "^(\\s*\\d+\\)\\s*\\d*\\)?)",
            "name": "comment"
        },
        {
            "match": "\\b(OK|BUSY|BUSYGROUP|BUSYKEY|CLUSTERDOWN|CROSSSLOT|DENIED|ERR|EXECABORT|INPROG|INVALIDOBJ|IOERR|LOADING|MASTERDOWN|MISCONF|NOAUTH|NOGOODSLAVE|NOGROUP|NOMASTERLINK|NOPERM|NOPROTO|NOQUORUM|NOREPLICAS|NOSCRIPT|NOTBUSY|OOM|READONLY|REDIRECT|TRYAGAIN|UNBLOCKED|UNKILLABLE|WRONGPASS|WRONGTYPE)\\b",
            "name": "constant.language"
        },
        {
            "match": "\\s(?i:\\+@?[a-z|]+|-@?[a-z|]+|~\\*)\\s",
            "name": "constant.language"
        },
        {
            "match": "(?i:\\b(on|off|nopass)\\b)",
            "name": "variable.parameter"
        },
        {
            "match": "\\((error|integer|double|nil|true|false|empty array|empty hash|empty set|empty push|empty aggregate type)\\)",
