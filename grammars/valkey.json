            "name": "support.function",
            "match": "(?i:\\b(json\\.objkeys|json\\.nummultby|json\\.numincrby|json\\.arrlen|json\\.arrappend|json\\.merge|json\\.objlen|json\\.forget|json\\.set|json\\.toggle|json\\.arrpop|json\\.clear|json\\.mset|json\\.get|json\\.del|json\\.arrinsert|json\\.strappend|json\\.resp|json\\.arrtrim|json\\.debug|json\\.mget|json\\.strlen|json\\.arrindex|json\\.type)\\b)"
